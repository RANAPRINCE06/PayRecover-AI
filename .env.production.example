# PayRecover AI — Production Environment Configuration Template
# Set these variables in your production environment / secrets manager

# Core Application Settings
ENVIRONMENT=production
APP_NAME=PayRecover AI
DEBUG=False
PORT=8001

# Production Security & JWT Authentication
# MUST be a cryptographically secure random string (minimum 32 characters)
# Example: openssl rand -hex 32
JWT_SECRET=PROD_SECRET_REPLACE_WITH_MINIMUM_32_CHARACTERS_HEX_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Production Database (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://payrecover_admin:SECURE_DB_PASSWORD@postgres:5432/payrecover_production

# Production Cache & Event Queue (Redis)
REDIS_URL=redis://redis:6379/0

# Payment Gateway (Razorpay Test Mode / Integration)
RAZORPAY_KEY_ID=rzp_test_prod_key_id
RAZORPAY_KEY_SECRET=rzp_test_prod_key_secret
USE_MOCK_PAYMENTS=False

# Google Gemini Enterprise API
GEMINI_API_KEY=PROD_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-flash

# CORS Allowed Origins (Comma-separated exact domains)
CORS_ORIGINS=https://app.payrecover.ai,https://payrecover.ai
