# App Settings
ENVIRONMENT=development
APP_NAME=PayRecover AI
DEBUG=True
PORT=8000
SECRET_KEY=payrecover-secret-key-change-in-production

# Database
# PostgreSQL connection string, falls back to local SQLite if unavailable
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payrecover_db
SQLITE_FALLBACK_URL=sqlite:///./payrecover.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Razorpay Test Mode
RAZORPAY_KEY_ID=rzp_test_sample_key_12345
RAZORPAY_KEY_SECRET=rzp_test_sample_secret_67890
USE_MOCK_PAYMENTS=True

# Gemini AI / LLM
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
