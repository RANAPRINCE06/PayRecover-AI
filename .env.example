# PayRecover AI — Development Environment Configuration Template
# Copy to .env for local development

# Core Settings
ENVIRONMENT=development
APP_NAME=PayRecover AI
DEBUG=True
PORT=8001

# Security & Authentication (JWT)
JWT_SECRET=change-this-in-production-to-a-secure-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database Configuration
# Primary: PostgreSQL (falls back to local SQLite if PostgreSQL is unreachable)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payrecover_db
SQLITE_FALLBACK_URL=sqlite:///./payrecover.db

# Cache & Message Broker
# Redis URL (falls back to in-memory cache if Redis is unreachable)
REDIS_URL=redis://localhost:6379/0

# Rate Limiting & Abuse Prevention (Login Protection)
LOGIN_RATE_LIMIT_ENABLED=True
LOGIN_IP_MAX_ATTEMPTS=5
LOGIN_IP_WINDOW_SECONDS=60
LOGIN_ACCOUNT_MAX_ATTEMPTS=5
LOGIN_ACCOUNT_WINDOW_SECONDS=60

# Session Security & JWT Revocation
AUTH_REVOCATION_ENABLED=True
AUTH_FAIL_CLOSED_ON_REDIS_ERROR=False

# Razorpay Test Mode & Webhook Integration
RAZORPAY_KEY_ID=rzp_test_sample_key_12345
RAZORPAY_KEY_SECRET=rzp_test_sample_secret_67890
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_sample_12345
USE_MOCK_PAYMENTS=True

# Google Gemini GenAI SDK
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
